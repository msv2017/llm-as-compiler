{
  "inputType": {
    "kind": "object",
    "name": "Request",
    "fields": {
      "customerId": {
        "kind": "primitive",
        "name": "String"
      }
    }
  },
  "outputType": {
    "kind": "object",
    "name": "Result",
    "fields": {
      "refunded": {
        "kind": "primitive",
        "name": "Bool"
      },
      "outstanding": {
        "kind": "primitive",
        "name": "Decimal"
      }
    }
  },
  "workflow": {
    "name": "CalculateOutstandingAndRefundIfNeeded",
    "nodes": [
      {
        "kind": "call",
        "tool": "billing.listInvoices",
        "arguments": {
          "customerId": {
            "kind": "path",
            "path": "input.customerId"
          }
        },
        "id": "listInvoices"
      },
      {
        "kind": "filter",
        "source": {
          "kind": "path",
          "path": "listInvoices"
        },
        "parameterName": "invoice",
        "predicate": {
          "kind": "binary",
          "left": {
            "kind": "path",
            "path": "invoice.status"
          },
          "operator": "Equal",
          "right": {
            "kind": "constant",
            "value": "UNPAID",
            "source": "PROMPT",
            "detail": "Filter unpaid invoices as instructed in prompt"
          }
        },
        "id": "unpaidInvoices"
      },
      {
        "kind": "aggregate",
        "source": {
          "kind": "path",
          "path": "unpaidInvoices"
        },
        "operation": "Sum",
        "parameterName": "invoice",
        "selector": {
          "kind": "path",
          "path": "invoice.amount"
        },
        "id": "outstandingBalance"
      },
      {
        "kind": "sort",
        "source": {
          "kind": "path",
          "path": "unpaidInvoices"
        },
        "parameterName": "invoice",
        "key": {
          "kind": "path",
          "path": "invoice.createdAt"
        },
        "direction": "ASCENDING",
        "id": "oldestUnpaidSorted"
      },
      {
        "kind": "aggregate",
        "source": {
          "kind": "path",
          "path": "oldestUnpaidSorted"
        },
        "operation": "First",
        "parameterName": "invoice",
        "id": "oldestInvoice"
      },
      {
        "kind": "if",
        "condition": {
          "kind": "binary",
          "left": {
            "kind": "path",
            "path": "outstandingBalance"
          },
          "operator": "LessThan",
          "right": {
            "kind": "constant",
            "value": 100,
            "source": "PROMPT",
            "detail": "Refund if balance less than 100 as instructed in prompt"
          }
        },
        "trueBranch": {
          "nodes": [
            {
              "kind": "if",
              "condition": {
                "kind": "binary",
                "left": {
                  "kind": "path",
                  "path": "oldestInvoice"
                },
                "operator": "NotEqual",
                "right": {
                  "kind": "constant",
                  "source": "SYSTEM_POLICY",
                  "detail": "Check oldestInvoice is not null before refunding"
                }
              },
              "trueBranch": {
                "nodes": [
                  {
                    "kind": "call",
                    "tool": "billing.createRefund",
                    "arguments": {
                      "invoiceId": {
                        "kind": "path",
                        "path": "oldestInvoice.id"
                      }
                    },
                    "id": "refund"
                  }
                ],
                "value": {
                  "kind": "constant",
                  "value": true,
                  "source": "PROMPT",
                  "detail": "Refund made because refund was issued"
                }
              },
              "falseBranch": {
                "nodes": [],
                "value": {
                  "kind": "constant",
                  "value": false,
                  "source": "PROMPT",
                  "detail": "No refund because no oldest invoice present"
                }
              },
              "id": "oldestInvoiceCheck"
            }
          ],
          "value": {
            "kind": "path",
            "path": "oldestInvoiceCheck"
          }
        },
        "falseBranch": {
          "nodes": [],
          "value": {
            "kind": "constant",
            "value": false,
            "source": "PROMPT",
            "detail": "No refund because balance not less than 100"
          }
        },
        "id": "refundDecision"
      }
    ],
    "return": {
      "refunded": {
        "kind": "path",
        "path": "refundDecision"
      },
      "outstanding": {
        "kind": "path",
        "path": "outstandingBalance"
      }
    }
  }
}